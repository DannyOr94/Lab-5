# Copia este archivo a .env para ejecutar localmente. No subas .env a Git.
# Si AUTH0_DOMAIN y AUTH0_CLIENT_ID están vacíos, el chat queda abierto para pruebas.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
APP_BASE_URL=http://localhost:3000

# URI PostgreSQL del rol una_chat_backend. Usa sslmode=verify-full.
VAULT_DATABASE_URL=

# No configures AUTH0_CLIENT_SECRET. El servidor lo lee de Supabase Vault.
